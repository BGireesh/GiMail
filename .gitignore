/target
/.ai/reference/
.DS_Store
__pycache__/

# Google OAuth client credentials. Each user supplies their own, so never commit one.
client_secret*.json
*oauth-client*.json

# Signing material never enters the repo. fastlane match keeps the certificate, and CI's secrets
# keep the rest.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.keychain-db
.env*
# What fastlane writes beside its files.
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
